# better-sqlite3 ships platform prebuilds inside its npm package, so no
# install-time compilation is needed. Some environments' npm still attempts
# an implicit `node-gyp rebuild` for packages with a binding.gyp and no
# custom install script, which fails offline/sandboxed environments that
# can't reach nodejs.org for header downloads. Ignoring install scripts
# avoids that entirely — this project has no dependency that requires one.
ignore-scripts=true
