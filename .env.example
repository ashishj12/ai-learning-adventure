GROQ_API_KEY=

# Optional. Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=llama-3.1-8b-instant

# Passcode required to access /admin (content management). Change this before
# any real deployment — the default below is NOT secret.
ADMIN_PASSCODE=adventure-admin

# Used to sign the admin session cookie. Change this before any real deployment.
ADMIN_COOKIE_SECRET=dev-only-secret-change-me
